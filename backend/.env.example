# ============================================
# 后端环境变量模板
# 位置：backend/.env.example
# 使用方法：复制本文件为 backend/.env，填入真实值。
# 注意：.env 已被 .gitignore 排除，严禁提交到 Git。
# ============================================

# --- 数据库 ---
# MySQL 连接串，格式：mysql+pymysql://用户名:密码@主机:端口/数据库名?charset=utf8mb4
# charset=utf8mb4 用于正确存储中文
DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/zhian?charset=utf8mb4

# --- 认证 ---
# JWT 签名密钥，生产环境务必改成足够长的随机字符串
SECRET_KEY=please-change-me-to-a-long-random-string
# Token 有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
# 允许跨域访问的前端来源，多个用英文逗号分隔（本地开发默认即可）
BACKEND_CORS_ORIGINS=http://localhost:5173

# --- SMTP 邮件（发送注册验证码）---
# QQ 邮箱 SMTP（SSL，端口 465）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@qq.com
SMTP_PASSWORD=your_smtp_auth_code
SMTP_FROM=your_email@qq.com
